{
  "name": "@research-os/researchd",
  "version": "0.1.0",
  "description": "ResearchOS daemon: HTTP/WebSocket-ish API, scheduler loop, verifier coordinator, mesh transport, Pi runtime adapter.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "researchd": "dist/main.js"
  },
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "typecheck": "tsc -p . --noEmit",
    "test": "node --test dist/test/*.test.js",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@research-os/contracts": "workspace:*",
    "@research-os/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
